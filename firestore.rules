rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pesan dari form kontak.
    match /messages/{id} {
      // Siapa pun boleh MENGIRIM pesan, tapi bentuknya dibatasi ketat.
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'read'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 2000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;

      // Hanya admin (akun Google terverifikasi) yang boleh MEMBACA, menandai, atau menghapus.
      allow read, update, delete: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['informatikauf2026@gmail.com', 'acabawell212@gmail.com'];
    }

    // Teks template PPT (diubah lewat tombol "Edit teks" di tampilan PPT).
    match /pptTemplate/{id} {
      // Semua pengunjung boleh membaca supaya teks terbaru tampil di web.
      allow read: if true;

      // Hanya admin yang boleh mengubah, dengan bentuk data yang dibatasi.
      allow create, update: if id == 'main'
        && request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['informatikauf2026@gmail.com', 'acabawell212@gmail.com']
        && request.resource.data.keys().hasOnly(['texts', 'updatedAt', 'updatedBy'])
        && request.resource.data.texts is map
        && request.resource.data.texts.size() <= 200
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.updatedAt == request.time;
    }
  }
}
