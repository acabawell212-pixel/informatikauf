rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pesan dari form kontak.
    match /messages/{id} {
      // Siapa pun boleh MENGIRIM pesan, tapi bentuknya dibatasi ketat.
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'read'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('.+@.+\..+')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 2000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;

      // Hanya admin (akun Google terverifikasi) yang boleh MEMBACA, menandai, atau menghapus.
      allow read, update, delete: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['informatikauf2026@gmail.com', 'acabawell212@gmail.com'];
    }
  }
}
